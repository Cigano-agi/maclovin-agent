# Chaves de API para Provedores de Inteligência Artificial
# Preencha a chave correspondente ao provedor configurado no config/config.yaml

# NVIDIA NIM / GLM (Ex: z-ai/glm-5.2, meta/llama-3.3-70b-instruct)
NVIDIA_API_KEY=

# Google Gemini API
GEMINI_API_KEY=

# OpenAI API (Opcional)
OPENAI_API_KEY=

# Anthropic Claude API (Opcional)
ANTHROPIC_API_KEY=

# Provedores locais ou URLs customizadas
OPENAI_BASE_URL=
OLLAMA_HOST=http://localhost:11434
